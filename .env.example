# Copy the Session Pooler or Direct connection URI from Supabase Dashboard > Connect.
# Do not expose this value to the browser or commit it to source control.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres

# Keep connection use below the limit for your Supabase compute plan.
DB_POOL_MAX=5

# Required in production to encrypt stored provider credentials.
PROVIDER_ENCRYPTION_KEY=replace-with-a-long-random-secret
